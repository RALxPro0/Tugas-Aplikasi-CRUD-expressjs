<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Task Tracker MVC — Aplikasi Manajemen Tugas</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex">

  <%
    const completionRate = stats.total > 0 ? Math.round((stats.completed / stats.total) * 100) : 0;
    const todayStr = new Date().toISOString().slice(0, 10);
  %>

  <!-- ==================== SIDEBAR DESKTOP ==================== -->
  <aside class="w-72 bg-slate-900 text-slate-300 flex-shrink-0 hidden lg:flex flex-col justify-between min-h-screen sticky top-0 h-screen border-r border-slate-800">
    <div class="p-6 space-y-8">
      <!-- Brand Logo -->
      <div class="flex items-center gap-3.5 pb-6 border-b border-slate-800">
        <div class="w-11 h-11 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-600/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-bold text-white tracking-tight leading-tight">Task Tracker</h1>
        </div>
      </div>

      <!-- Tombol Cepat Tambah Tugas di Sidebar -->
      <div>
        <button
          type="button"
          onclick="openCreateModal()"
          class="w-full py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-md shadow-indigo-600/25 transition flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>Buat Tugas Baru</span>
        </button>
      </div>

      <!-- Menu Filter Status -->
      <div class="space-y-1.5">
        <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">
          Filter Status Tugas
        </p>

        <a
          href="/"
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= !filters.status ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>"
        >
          <span class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
            Semua Tugas
          </span>
          <span class="px-2 py-0.5 text-xs rounded-md font-semibold <%= !filters.status ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-slate-400' %>">
            <%= stats.total %>
          </span>
        </a>

        <a
          href="/?status=Belum+Dikerjakan"
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= filters.status === 'Belum Dikerjakan' ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>"
        >
          <span class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            Belum Dikerjakan
          </span>
          <span class="px-2 py-0.5 text-xs rounded-md font-semibold bg-slate-800 text-slate-300">
            <%= stats.todo %>
          </span>
        </a>

        <a
          href="/?status=Sedang+Dikerjakan"
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= filters.status === 'Sedang Dikerjakan' ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>"
        >
          <span class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Sedang Dikerjakan
          </span>
          <span class="px-2 py-0.5 text-xs rounded-md font-semibold bg-slate-800 text-amber-400">
            <%= stats.inProgress %>
          </span>
        </a>

        <a
          href="/?status=Selesai"
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= filters.status === 'Selesai' ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>"
        >
          <span class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Selesai
          </span>
          <span class="px-2 py-0.5 text-xs rounded-md font-semibold bg-slate-800 text-emerald-400">
            <%= stats.completed %>
          </span>
        </a>
      </div>

      <!-- Menu Filter Prioritas -->
      <div class="space-y-1.5">
        <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">
          Filter Prioritas
        </p>

        <a
          href="/?priority=Tinggi"
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-sm font-medium transition <%= filters.priority === 'Tinggi' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>"
        >
          <span class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Prioritas Tinggi
          </span>
        </a>

        <a
          href="/?priority=Sedang"
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-sm font-medium transition <%= filters.priority === 'Sedang' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>"
        >
          <span class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Prioritas Sedang
          </span>
        </a>

        <a
          href="/?priority=Rendah"
          class="flex items-center justify-between px-3.5 py-2 rounded-xl text-sm font-medium transition <%= filters.priority === 'Rendah' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200' %>"
        >
          <span class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Prioritas Rendah
          </span>
        </a>
      </div>
    </div>

    <!-- Bagian Bawah Sidebar: Progress -->
    <div class="p-6 border-t border-slate-800">
      <div class="bg-slate-800/90 rounded-2xl p-4 border border-slate-700/70">
        <div class="flex items-center justify-between text-xs font-semibold mb-2">
          <span class="text-slate-300">Progres Penyelesaian</span>
          <span class="text-indigo-400 font-bold"><%= completionRate %>%</span>
        </div>
        <div class="w-full h-2 bg-slate-700 rounded-full overflow-hidden">
          <div
            class="h-full bg-indigo-500 rounded-full transition-all duration-500"
            style="width: <%= completionRate %>%"
          ></div>
        </div>
        <p class="text-[11px] text-slate-400 mt-2">
          <%= stats.completed %> dari <%= stats.total %> tugas telah selesai
        </p>
      </div>
    </div>
  </aside>

  <!-- ==================== AREA KERJA UTAMA (DESKTOP WORKSPACE) ==================== -->
  <div class="flex-1 flex flex-col min-w-0">

    <!-- Top Header Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-20">
      <div class="px-6 lg:px-10 py-4 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">
            Dashboard Manajemen Tugas
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Kelola daftar pekerjaan, prioritas, dan tenggat waktu dalam satu tampilan tabel terpadu.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            onclick="openCreateModal()"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>Tambah Tugas Baru</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Konten Utama -->
    <main class="flex-1 px-6 lg:px-10 py-8 space-y-6 max-w-[1600px] w-full mx-auto">

      <!-- Alert Sukses -->
      <% if (message) { %>
        <div id="alert-box" class="flex items-center justify-between gap-4 px-5 py-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-sm font-semibold"><%= message %></span>
          </div>
          <button onclick="document.getElementById('alert-box').remove()" class="text-emerald-600 hover:text-emerald-900 font-bold text-lg leading-none px-2 cursor-pointer">
            &times;
          </button>
        </div>
      <% } %>

      <!-- Alert Error -->
      <% if (error) { %>
        <div id="error-box" class="flex items-center justify-between gap-4 px-5 py-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-sm font-semibold"><%= error %></span>
          </div>
          <button onclick="document.getElementById('error-box').remove()" class="text-rose-600 hover:text-rose-900 font-bold text-lg leading-none px-2 cursor-pointer">
            &times;
          </button>
        </div>
      <% } %>

      <!-- 4 Kartu Statistik Desktop -->
      <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
        <div class="bg-white rounded-2xl p-5 border border-slate-200/90 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Tugas</p>
            <p class="text-3xl font-extrabold text-slate-900 mt-1.5"><%= stats.total %></p>
            <p class="text-xs text-slate-500 mt-1">Seluruh tugas terdaftar</p>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200/90 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Belum Dikerjakan</p>
            <p class="text-3xl font-extrabold text-slate-800 mt-1.5"><%= stats.todo %></p>
            <p class="text-xs text-slate-500 mt-1">Menunggu pengerjaan</p>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-600 flex items-center justify-center border border-slate-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200/90 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-amber-600">Sedang Dikerjakan</p>
            <p class="text-3xl font-extrabold text-amber-600 mt-1.5"><%= stats.inProgress %></p>
            <p class="text-xs text-slate-500 mt-1">Dalam proses aktif</p>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200/90 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">Tugas Selesai</p>
            <p class="text-3xl font-extrabold text-emerald-600 mt-1.5"><%= stats.completed %></p>
            <p class="text-xs text-slate-500 mt-1"><%= completionRate %>% dari total tugas</p>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
      </section>

      <!-- Panel Tabel Utama (Full Width Desktop) -->
      <section class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">

        <!-- Toolbar Pencarian & Filter -->
        <div class="p-5 border-b border-slate-200 bg-slate-50/50 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div class="flex items-center gap-3">
            <h3 class="text-base font-bold text-slate-900">Daftar Tugas</h3>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
              <%= tasks.length %> Data
            </span>
          </div>

          <form action="/" method="GET" class="flex flex-wrap items-center gap-2.5">
            <div class="relative w-full sm:w-72">
              <input
                type="text"
                name="search"
                value="<%= filters.search %>"
                placeholder="Cari judul atau deskripsi tugas..."
                class="w-full pl-9 pr-3.5 py-2 text-sm bg-white rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition"
              />
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>

            <select
              name="status"
              class="px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white text-slate-700 focus:border-indigo-500 outline-none cursor-pointer"
            >
              <option value="">Semua Status</option>
              <option value="Belum Dikerjakan" <%= filters.status === 'Belum Dikerjakan' ? 'selected' : '' %>>Belum Dikerjakan</option>
              <option value="Sedang Dikerjakan" <%= filters.status === 'Sedang Dikerjakan' ? 'selected' : '' %>>Sedang Dikerjakan</option>
              <option value="Selesai" <%= filters.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
            </select>

            <select
              name="priority"
              class="px-3.5 py-2 text-sm rounded-xl border border-slate-300 bg-white text-slate-700 focus:border-indigo-500 outline-none cursor-pointer"
            >
              <option value="">Semua Prioritas</option>
              <option value="Tinggi" <%= filters.priority === 'Tinggi' ? 'selected' : '' %>>Prioritas Tinggi</option>
              <option value="Sedang" <%= filters.priority === 'Sedang' ? 'selected' : '' %>>Prioritas Sedang</option>
              <option value="Rendah" <%= filters.priority === 'Rendah' ? 'selected' : '' %>>Prioritas Rendah</option>
            </select>

            <button
              type="submit"
              class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition cursor-pointer"
            >
              Terapkan
            </button>

            <% if (filters.search || filters.status || filters.priority) { %>
              <a
                href="/"
                class="px-3.5 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 text-slate-600 text-sm font-semibold transition"
              >
                Reset
              </a>
            <% } %>
          </form>
        </div>

        <!-- Tabel Data Desktop -->
        <% if (tasks.length === 0) { %>
          <div class="py-16 px-6 text-center">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <h4 class="text-base font-bold text-slate-800">Tidak ada data tugas ditemukan</h4>
            <p class="text-sm text-slate-500 mt-1 max-w-md mx-auto">
              Belum ada tugas yang sesuai dengan pencarian atau filter. Klik tombol di bawah untuk membuat tugas baru.
            </p>
            <button
              type="button"
              onclick="openCreateModal()"
              class="mt-5 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <span>Tambah Tugas Pertama</span>
            </button>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                  <th class="py-4 pl-6 pr-3 w-16">No</th>
                  <th class="py-4 px-4 min-w-[320px]">Judul &amp; Deskripsi Tugas</th>
                  <th class="py-4 px-4 w-40">Prioritas</th>
                  <th class="py-4 px-4 w-52">Status Pengerjaan</th>
                  <th class="py-4 px-4 w-44">Tenggat Waktu</th>
                  <th class="py-4 pl-4 pr-6 w-44 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200/70 text-sm">
                <% tasks.forEach((task, index) => { %>
                  <%
                    const priorityBadge =
                      task.priority === 'Tinggi'
                        ? 'bg-rose-50 text-rose-700 border-rose-200'
                        : task.priority === 'Sedang'
                        ? 'bg-amber-50 text-amber-700 border-amber-200'
                        : 'bg-emerald-50 text-emerald-700 border-emerald-200';

                    const priorityDot =
                      task.priority === 'Tinggi'
                        ? 'bg-rose-500'
                        : task.priority === 'Sedang'
                        ? 'bg-amber-500'
                        : 'bg-emerald-500';

                    const statusSelectStyle =
                      task.status === 'Selesai'
                        ? 'bg-emerald-50 text-emerald-700 border-emerald-200 focus:ring-emerald-100'
                        : task.status === 'Sedang Dikerjakan'
                        ? 'bg-amber-50 text-amber-700 border-amber-200 focus:ring-amber-100'
                        : 'bg-slate-100 text-slate-700 border-slate-200 focus:ring-slate-200';

                    const rawStartDate = task.start_date
                      ? String(task.start_date).slice(0, 10)
                      : task.created_at
                      ? String(task.created_at).slice(0, 10)
                      : todayStr;
                    const rawDueDate = task.due_date ? String(task.due_date).slice(0, 10) : '';

                    const formattedStartDate = rawStartDate
                      ? new Date(rawStartDate + 'T00:00:00').toLocaleDateString('id-ID', {
                          day: '2-digit',
                          month: 'short',
                        })
                      : '-';

                    const formattedDueDate = rawDueDate
                      ? new Date(rawDueDate + 'T00:00:00').toLocaleDateString('id-ID', {
                          day: '2-digit',
                          month: 'short',
                          year: 'numeric',
                        })
                      : '-';

                    const durationDays = rawDueDate
                      ? Math.round(
                          (new Date(rawDueDate + 'T00:00:00') - new Date(rawStartDate + 'T00:00:00')) /
                            (1000 * 60 * 60 * 24)
                        )
                      : null;
                  %>
                  <tr class="hover:bg-slate-50/90 transition">
                    <td class="py-4 pl-6 pr-3 font-semibold text-slate-400">
                      #<%= index + 1 %>
                    </td>

                    <td class="py-4 px-4">
                      <p class="font-bold text-slate-900 text-[15px] <%= task.status === 'Selesai' ? 'line-through text-slate-400' : '' %>">
                        <%= task.title %>
                      </p>
                      <% if (task.description) { %>
                        <p class="text-xs text-slate-500 mt-1 leading-relaxed max-w-2xl">
                          <%= task.description %>
                        </p>
                      <% } else { %>
                        <p class="text-xs text-slate-400 italic mt-0.5">Tidak ada deskripsi</p>
                      <% } %>
                    </td>

                    <td class="py-4 px-4 whitespace-nowrap">
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border <%= priorityBadge %>">
                        <span class="w-1.5 h-1.5 rounded-full <%= priorityDot %>"></span>
                        <%= task.priority %>
                      </span>
                    </td>

                    <td class="py-4 px-4 whitespace-nowrap">
                      <form action="/tasks/<%= task.id %>/status" method="POST">
                        <select
                          name="status"
                          onchange="this.form.submit()"
                          class="text-xs font-bold px-3 py-1.5 rounded-xl border cursor-pointer outline-none focus:ring-2 transition <%= statusSelectStyle %>"
                        >
                          <option value="Belum Dikerjakan" <%= task.status === 'Belum Dikerjakan' ? 'selected' : '' %>>Belum Dikerjakan</option>
                          <option value="Sedang Dikerjakan" <%= task.status === 'Sedang Dikerjakan' ? 'selected' : '' %>>Sedang Dikerjakan</option>
                          <option value="Selesai" <%= task.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
                        </select>
                      </form>
                    </td>

                    <td class="py-4 px-4 whitespace-nowrap">
                      <% if (rawDueDate) { %>
                        <div class="flex flex-col items-start gap-1">
                          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700">
                            <span><%= formattedStartDate %></span>
                            <span class="text-slate-400">&rarr;</span>
                            <span><%= formattedDueDate %></span>
                          </div>

                          <% if (task.status === 'Selesai') { %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500 border border-slate-200">
                              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                              <%= Math.max(0, durationDays) %> Hari
                            </span>
                          <% } else if (durationDays < 0) { %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-800 border border-rose-300">
                              <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-ping"></span>
                              Lewat <%= Math.abs(durationDays) %> Hari
                            </span>
                          <% } else if (durationDays === 0) { %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                              <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                              Hari Ini
                            </span>
                          <% } else if (durationDays <= 3) { %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                              <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                              <%= durationDays %> Hari
                            </span>
                          <% } else if (durationDays <= 7) { %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                              <%= durationDays %> Hari
                            </span>
                          <% } else { %>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                              <%= durationDays %> Hari
                            </span>
                          <% } %>
                        </div>
                      <% } else { %>
                        <span class="text-xs text-slate-400 italic">-</span>
                      <% } %>
                    </td>

                    <td class="py-4 pl-4 pr-6 whitespace-nowrap text-right">
                      <div class="inline-flex items-center justify-end gap-2">
                        <button
                          type="button"
                          onclick="openEditModal(this)"
                          data-id="<%= task.id %>"
                          data-title="<%= task.title %>"
                          data-description="<%= task.description || '' %>"
                          data-priority="<%= task.priority %>"
                          data-status="<%= task.status %>"
                          data-startdate="<%= rawStartDate %>"
                          data-duedate="<%= rawDueDate %>"
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200/80 transition cursor-pointer"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                          Edit
                        </button>

                        <form
                          action="/tasks/<%= task.id %>/delete"
                          method="POST"
                          onsubmit="return confirm('Apakah Anda yakin ingin menghapus tugas ini?');"
                          class="inline"
                        >
                          <button
                            type="submit"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200/80 transition cursor-pointer"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Hapus
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <!-- Footer Tabel -->
        <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
          <span>Menampilkan <strong><%= tasks.length %></strong> tugas dari total <strong><%= stats.total %></strong> data</span>
        </div>
      </section>

    </main>
  </div>

  <!-- ==================== MODAL TAMBAH TUGAS BARU ==================== -->
  <div
    id="createModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4"
  >
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-slate-900">Tambah Tugas Baru</h3>
          <p class="text-xs text-slate-500">Isi detail pekerjaan yang ingin ditambahkan ke daftar tugas</p>
        </div>
        <button
          type="button"
          onclick="closeCreateModal()"
          class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 flex items-center justify-center text-xl leading-none cursor-pointer"
        >
          &times;
        </button>
      </div>

      <form action="/tasks" method="POST" class="p-6 space-y-4">
        <div>
          <label for="create_title" class="block text-xs font-bold text-slate-700 mb-1.5">
            Judul Tugas <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="create_title"
            name="title"
            required
            placeholder="Contoh: Membuat laporan praktikum pemrograman web"
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          />
        </div>

        <div>
          <label for="create_description" class="block text-xs font-bold text-slate-700 mb-1.5">
            Deskripsi Tugas
          </label>
          <textarea
            id="create_description"
            name="description"
            rows="3"
            placeholder="Tulis rincian atau catatan tambahan untuk tugas ini..."
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="create_priority" class="block text-xs font-bold text-slate-700 mb-1.5">
              Prioritas
            </label>
            <select
              id="create_priority"
              name="priority"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 bg-white focus:border-indigo-500 outline-none"
            >
              <option value="Rendah">Rendah</option>
              <option value="Sedang" selected>Sedang</option>
              <option value="Tinggi">Tinggi</option>
            </select>
          </div>

          <div>
            <label for="create_status" class="block text-xs font-bold text-slate-700 mb-1.5">
              Status Awal
            </label>
            <select
              id="create_status"
              name="status"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 bg-white focus:border-indigo-500 outline-none"
            >
              <option value="Belum Dikerjakan" selected>Belum Dikerjakan</option>
              <option value="Sedang Dikerjakan">Sedang Dikerjakan</option>
              <option value="Selesai">Selesai</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="create_start_date" class="block text-xs font-bold text-slate-700 mb-1.5">
              Tanggal Mulai (Awal)
            </label>
            <input
              type="date"
              id="create_start_date"
              name="start_date"
              value="<%= todayStr %>"
              onchange="updateDurationPreview('create_start_date', 'create_due_date', 'create_duration_preview')"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
            />
          </div>

          <div>
            <label for="create_due_date" class="block text-xs font-bold text-slate-700 mb-1.5">
              Tenggat Akhir (Deadline)
            </label>
            <input
              type="date"
              id="create_due_date"
              name="due_date"
              onchange="updateDurationPreview('create_start_date', 'create_due_date', 'create_duration_preview')"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
            />
          </div>
        </div>

        <div id="create_duration_preview" class="hidden"></div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
          <button
            type="button"
            onclick="closeCreateModal()"
            class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold hover:bg-slate-100 transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-sm transition cursor-pointer"
          >
            Simpan Tugas
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==================== MODAL EDIT TUGAS ==================== -->
  <div
    id="editModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4"
  >
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-slate-900">Edit Data Tugas</h3>
          <p class="text-xs text-slate-500">Perbarui informasi tugas yang dipilih</p>
        </div>
        <button
          type="button"
          onclick="closeEditModal()"
          class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 flex items-center justify-center text-xl leading-none cursor-pointer"
        >
          &times;
        </button>
      </div>

      <form id="editForm" method="POST" class="p-6 space-y-4">
        <div>
          <label for="modal_title" class="block text-xs font-bold text-slate-700 mb-1.5">
            Judul Tugas <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="modal_title"
            name="title"
            required
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          />
        </div>

        <div>
          <label for="modal_description" class="block text-xs font-bold text-slate-700 mb-1.5">
            Deskripsi Tugas
          </label>
          <textarea
            id="modal_description"
            name="description"
            rows="3"
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="modal_priority" class="block text-xs font-bold text-slate-700 mb-1.5">
              Prioritas
            </label>
            <select
              id="modal_priority"
              name="priority"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 bg-white focus:border-indigo-500 outline-none"
            >
              <option value="Rendah">Rendah</option>
              <option value="Sedang">Sedang</option>
              <option value="Tinggi">Tinggi</option>
            </select>
          </div>

          <div>
            <label for="modal_status" class="block text-xs font-bold text-slate-700 mb-1.5">
              Status
            </label>
            <select
              id="modal_status"
              name="status"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 bg-white focus:border-indigo-500 outline-none"
            >
              <option value="Belum Dikerjakan">Belum Dikerjakan</option>
              <option value="Sedang Dikerjakan">Sedang Dikerjakan</option>
              <option value="Selesai">Selesai</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="modal_start_date" class="block text-xs font-bold text-slate-700 mb-1.5">
              Tanggal Mulai (Awal)
            </label>
            <input
              type="date"
              id="modal_start_date"
              name="start_date"
              onchange="updateDurationPreview('modal_start_date', 'modal_due_date', 'modal_duration_preview')"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
            />
          </div>

          <div>
            <label for="modal_due_date" class="block text-xs font-bold text-slate-700 mb-1.5">
              Tenggat Akhir (Deadline)
            </label>
            <input
              type="date"
              id="modal_due_date"
              name="due_date"
              onchange="updateDurationPreview('modal_start_date', 'modal_due_date', 'modal_duration_preview')"
              class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-300 focus:border-indigo-500 outline-none"
            />
          </div>
        </div>

        <div id="modal_duration_preview" class="hidden"></div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
          <button
            type="button"
            onclick="closeEditModal()"
            class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-bold hover:bg-slate-100 transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-sm transition cursor-pointer"
          >
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Script Pengaturan Modal & Kalkulasi Durasi -->
  <script>
    const createModal = document.getElementById('createModal');
    const editModal = document.getElementById('editModal');
    const editForm = document.getElementById('editForm');

    function updateDurationPreview(startId, dueId, previewId) {
      const startVal = document.getElementById(startId).value;
      const dueVal = document.getElementById(dueId).value;
      const previewEl = document.getElementById(previewId);

      if (!startVal || !dueVal) {
        previewEl.className = 'hidden';
        previewEl.innerHTML = '';
        return;
      }

      const diffDays = Math.round(
        (new Date(dueVal + 'T00:00:00') - new Date(startVal + 'T00:00:00')) / (1000 * 60 * 60 * 24)
      );

      if (diffDays < 0) {
        previewEl.className = 'p-3 rounded-xl bg-rose-100 border border-rose-300 text-rose-800 text-xs font-bold flex items-center justify-between';
        previewEl.innerHTML = '<span>⚠️ Tenggat akhir melewati tanggal mulai (' + Math.abs(diffDays) + ' hari lalu)</span><span>Lewat Tenggat</span>';
      } else if (diffDays <= 3) {
        previewEl.className = 'p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold flex items-center justify-between';
        previewEl.innerHTML = '<span>🔥 Durasi ' + (diffDays === 0 ? 'Hari yang Sama (< 1 hari)' : diffDays + ' Hari') + '</span><span class="px-2 py-0.5 rounded-full bg-rose-600 text-white text-[10px]">Mepet Deadline!</span>';
      } else if (diffDays <= 7) {
        previewEl.className = 'p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 text-xs font-bold flex items-center justify-between';
        previewEl.innerHTML = '<span>⏳ Durasi Pengerjaan: ' + diffDays + ' Hari</span><span>Mendekati Deadline</span>';
      } else {
        previewEl.className = 'p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold flex items-center justify-between';
        previewEl.innerHTML = '<span>📅 Durasi Pengerjaan: ' + diffDays + ' Hari</span><span>Waktu Longgar</span>';
      }
    }

    function openCreateModal() {
      createModal.classList.remove('hidden');
      createModal.classList.add('flex');
      updateDurationPreview('create_start_date', 'create_due_date', 'create_duration_preview');
      setTimeout(() => document.getElementById('create_title').focus(), 50);
    }

    function closeCreateModal() {
      createModal.classList.add('hidden');
      createModal.classList.remove('flex');
    }

    function openEditModal(button) {
      const id = button.getAttribute('data-id');
      const title = button.getAttribute('data-title');
      const description = button.getAttribute('data-description');
      const priority = button.getAttribute('data-priority');
      const status = button.getAttribute('data-status');
      const startDate = button.getAttribute('data-startdate');
      const dueDate = button.getAttribute('data-duedate');

      editForm.action = '/tasks/' + id + '/update';
      document.getElementById('modal_title').value = title;
      document.getElementById('modal_description').value = description;
      document.getElementById('modal_priority').value = priority;
      document.getElementById('modal_status').value = status;
      document.getElementById('modal_start_date').value = startDate;
      document.getElementById('modal_due_date').value = dueDate;

      updateDurationPreview('modal_start_date', 'modal_due_date', 'modal_duration_preview');

      editModal.classList.remove('hidden');
      editModal.classList.add('flex');
      setTimeout(() => document.getElementById('modal_title').focus(), 50);
    }

    function closeEditModal() {
      editModal.classList.add('hidden');
      editModal.classList.remove('flex');
    }

    createModal.addEventListener('click', function (e) {
      if (e.target === createModal) closeCreateModal();
    });
    editModal.addEventListener('click', function (e) {
      if (e.target === editModal) closeEditModal();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeCreateModal();
        closeEditModal();
      }
    });
  </script>
</body>
</html>
